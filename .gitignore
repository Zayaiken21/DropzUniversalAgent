# ---------------------------------------------------------

# MT5 terminal cache
MQL5/Logs/
MQL5/Profiles/
MQL5/Bases/
MQL5/Tester/
MQL5/Shared Projects/

# MT5 generated binaries
*.ex5
*.mqh~

# TradeSmart bridge outputs
TradeSmart_AI_DrawCommands.json1
TradeSmart_AI_DrawCommands.jsonl
TradeSmart_AI_Debug_LastSignal.json
TradeSmart_AI_PDF_Memory.json

# Runtime state
data/
state/
runtime/
cache/
temp/
tmp/

# Local account configs
account.json
accounts.json
profiles.json
mt5_profile.json
trade_profile.json
*.credentials.json

# Agent state
tradesmart_agent_state.json
session_state.json

# ---------------------------------------------------------
# AI / PDF Learning
# ---------------------------------------------------------

# Ignore extracted memory/cache
strategies/pdfs/cache/
strategies/pdfs/vectorstore/
strategies/pdfs/embeddings/
strategies/pdfs/chunks/
strategies/pdfs/index/

# Keep actual PDFs tracked if desired:
